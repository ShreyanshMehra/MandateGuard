# Copy to .env and override before running docker compose.
# These are prototype/dev credentials only — see HANDOFF.md section 14.

POSTGRES_USER=mandateguard_admin
POSTGRES_PASSWORD=dev_admin_change_me
POSTGRES_DB=mandateguard

BROKER_DB_PASSWORD=dev_broker_change_me
BANK_DB_PASSWORD=dev_bank_change_me

# Shared secret authenticating the broker to the mock bank's internal API.
# Stands in for mTLS/workload identity, which is out of scope for the
# prototype (see HANDOFF.md section 14).
BROKER_SERVICE_TOKEN=dev_broker_service_token_change_me
